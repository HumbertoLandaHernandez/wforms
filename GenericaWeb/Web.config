<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Ajuste el servidor. Para autenticación SQL: User ID=...;Password=... en lugar de Integrated Security -->
    <add name="Generica" providerName="System.Data.SqlClient"
         connectionString="Data Source=localhost;Initial Catalog=Generica;Integrated Security=True" />
  </connectionStrings>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <!-- Clave HMAC-SHA256 del JWT (mínimo 32 caracteres). En producción use la variable de entorno GENERICA_JWT_CLAVE. -->
    <add key="Jwt:Clave" value="P8kwpLVJAw4G8I3IbT_up5V0Dw896PiS8XEOK9glJqVDrVAVF07yvjinAafnBXYn" />
    <add key="Jwt:Emisor" value="GenericaWeb" />
    <add key="Jwt:Audiencia" value="GenericaWeb" />
    <add key="Jwt:MinutosExpiracion" value="60" />
    <!-- Rol con acceso total a todas las páginas -->
    <add key="Seguridad:RolAdministradorId" value="1" />
    <!-- PermisoId que solo permite consultar (sin crear/modificar/eliminar) -->
    <add key="Seguridad:PermisoSoloLecturaId" value="1" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" />
    <!-- La autenticación la realiza Seguridad/JwtAuthModule -->
    <authentication mode="None" />
    <sessionState mode="Off" />
    <globalization culture="es-MX" uiCulture="es" fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <customErrors mode="RemoteOnly" />
    <httpCookies httpOnlyCookies="true" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" />
  </system.web>
  <system.webServer>
    <modules>
      <add name="JwtAuthModule" type="GenericaWeb.Seguridad.JwtAuthModule, GenericaWeb" />
    </modules>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
